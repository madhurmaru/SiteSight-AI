{
  "name": "sitesight-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3001",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0 --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:setup": "node --import tsx scripts/setup.ts",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:backfill-reports": "node --env-file=.env --import tsx scripts/backfill-inspection-reports.ts",
    "worker": "node --env-file=.env --import tsx scripts/worker.ts",
    "worker:inference": "set -a && . ./.env && set +a && worker/.venv/bin/uvicorn --app-dir worker app:app --host 127.0.0.1 --port 8001",
    "models:download": "sh scripts/download-models.sh",
    "test": "node --env-file=.env --import tsx --test tests/*.test.ts",
    "test:e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "postinstall": "prisma generate",
    "test:python": "python3 -m unittest discover -s worker -p test_*.py",
    "test:real-inference": "worker/.venv/bin/python worker/evaluate.py",
    "test:detection-eval": "worker/.venv/bin/python worker/evaluate_detection.py",
    "format": "prettier --write app lib scripts tests docs README.md"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "effect": "^3.20.0",
    "deepmerge-ts": "^8.0.0"
  }
}
