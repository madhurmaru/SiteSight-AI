# Explicit modes: demo or connected. Never falls back to demo automatically.
APP_MODE=demo
DATABASE_URL="file:./demo.db"
APP_ORIGIN=http://127.0.0.1:3001

# Connected mode: generate prisma/pg/schema.prisma, apply its migrations.
# DATABASE_URL=postgresql://sitesight:YOUR_PASSWORD@localhost:5432/sitesight
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sitesight-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
INFERENCE_URL=http://localhost:8001
WORKER_SECRET=
INFERENCE_ADAPTER=fixture
DETECTOR_WEIGHTS=/weights/ppe.pt
WORKER_DETECTOR_WEIGHTS=/weights/person.pt
WORKER_CLASS_NAME=person
DETECTOR_NAME=
DETECTOR_VERSION=
DETECTOR_SOURCE=
DETECTOR_LICENSE=
DETECTOR_RUNTIME_LICENSE=
DETECTOR_CLASS_MAP={"Hardhat":"helmet","Safety Vest":"vest","NO-Hardhat":"no-helmet","NO-Safety Vest":"no-vest"}
STORAGE_ALLOWED_HOSTS=minio,localhost,127.0.0.1
MAX_VIDEO_SECONDS=60
MAX_VIDEO_FRAMES=8
PYTHON_BIN=python3

# Optional Hugging Face Inference Providers integration; no token is included.
# Use the generic router so Hugging Face can select a provider compatible with
# the configured model. Pinning a provider is optional and may reject models
# that the provider no longer serves.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1600

# Docker service credentials, supplied locally before connected deployment.
POSTGRES_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
